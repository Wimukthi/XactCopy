<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>XactCopy.Benchmarks</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OptionExplicit>On</OptionExplicit>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\XactCopy.Core\XactCopy.Core.vbproj" />
    <ProjectReference Include="..\..\src\XactCopy.Storage\XactCopy.Storage.vbproj" />
    <ProjectReference Include="..\..\src\XactCopy.Worker\XactCopy.Worker.vbproj" />
  </ItemGroup>

</Project>
