// XactCopyExecutive (worker) resources: application icon + version information.
// The worker is launched by the UI, but it still shows up in Task Manager and
// UAC/security prompts, so it carries the same icon and version metadata.
#include <windows.h>

#include "..\\version.h"

#define IDI_XACTCOPY 101

IDI_XACTCOPY ICON "..\\..\\Icons\\xactcopy.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION XACTCOPY_VERSION_COMMA
 PRODUCTVERSION XACTCOPY_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Wimukthi Bandara"
            VALUE "FileDescription", "XactCopy copy/scan worker"
            VALUE "FileVersion", XACTCOPY_VERSION_STRING
            VALUE "InternalName", "XactCopyExecutive"
            VALUE "OriginalFilename", "XactCopyExecutive.exe"
            VALUE "ProductName", "XactCopy"
            VALUE "ProductVersion", XACTCOPY_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
